@namespace IdentityCenter.API.AdminUi.Shared
@inherits LayoutComponentBase

<div class="admin-shell">
    <header class="admin-topbar">
        <div class="admin-brand">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22"
                 fill="none" stroke="var(--color-primary)" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" />
                <path d="M9 12l2 2 4-4" />
            </svg>
            <span>IdentityCenter API</span>
        </div>
        <nav class="admin-nav">
            <NavLink href="/admin" Match="NavLinkMatch.All" class="admin-nav-link" ActiveClass="active">Dashboard</NavLink>
            <NavLink href="/admin/logs" class="admin-nav-link" ActiveClass="active">Live Logs</NavLink>
        </nav>
        <div class="admin-user">
            <AuthorizeView>
                <Authorized>
                    <span class="admin-user-name">@context.User.Identity?.Name</span>
                    <form method="post" action="/admin/logout" class="admin-logout-form">
                        <input type="hidden" name="__RequestVerificationToken" value="@AntiforgeryToken" />
                        <button type="submit" class="admin-logout-btn">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="admin-main">
        @Body
    </main>
</div>

@code {
    [CascadingParameter(Name = "AntiforgeryToken")]
    public string? AntiforgeryToken { get; set; }
}
